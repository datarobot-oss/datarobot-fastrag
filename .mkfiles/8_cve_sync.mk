##@ CVE floor policy (cve-sync)

# GENERATED by `cve-sync wiring --write`. Do not edit.
#
# Every resync rewrites this file. Change `wiring.COMMANDS` in
# datarobot-oss/cve-sync instead.
#
# A repo that uses make cannot include upstream's Taskfile, so this is the
# same command set emitted in make's dialect from the same definition.
#
# Local commands for datarobot-oss/cve-sync, the shared CVE floor policy.
#
# The policy ships inside the cve-sync wheel, so nothing else to install.
# Commands run against CVE_SYNC_REF (default: main); override it to pin, or
# to test a branch or tag.
#
# Every command covers each resolution root in the repo (a pyproject.toml
# beside its own uv.lock).
#
# To try an unreleased change from a local cve-sync checkout:
#
#   CVE_SYNC_FROM=~/workspaces/cve-sync <run the status command>

CVE_SYNC_REPO_URL ?= https://github.com/datarobot-oss/cve-sync.git
CVE_SYNC_REF ?= main
CVE_SYNC_FROM ?= git+$(CVE_SYNC_REPO_URL)@$(CVE_SYNC_REF)
# The directory of the Makefile that included this one, which is the repo root.
# Not $(CURDIR): that is wherever make was invoked from, so `make -f ../Makefile`
# run from a subdirectory would target the wrong tree.
CVE_SYNC_TARGET ?= $(abspath $(dir $(firstword $(MAKEFILE_LIST))))
CVE_SYNC_BASE_REF ?= origin/main
CVE_SYNC := uvx --from "$(CVE_SYNC_FROM)" cve-sync

.PHONY: cve-sync-roots
cve-sync-roots:  ## List the resolution roots cve-sync acts on. Each needs its own residue.
	@$(CVE_SYNC) roots --target $(CVE_SYNC_TARGET)

.PHONY: cve-sync-status
cve-sync-status:  ## Is any root's residue behind the policy? Reads only, writes nothing.
	@$(CVE_SYNC) sync --target $(CVE_SYNC_TARGET) --dry-run

.PHONY: cve-sync-sync
cve-sync-sync:  ## Splice the residue into every root and re-lock.
	@$(CVE_SYNC) sync --target $(CVE_SYNC_TARGET) --apply

# Per root, because overrides are scoped per project. A bare `render`
# emits only the global floors, which is not what any one root carries.
.PHONY: cve-sync-render
cve-sync-render:  ## Print every floor plus each root's own overrides. Unscoped, unlike what sync writes.
	@$(CVE_SYNC) render --format toml --target $(CVE_SYNC_TARGET) --all-roots

.PHONY: cve-sync-audit
cve-sync-audit:  ## What is vulnerable here that policy does not already cover. Reads only.
	@$(CVE_SYNC) audit --target $(CVE_SYNC_TARGET)

.PHONY: cve-sync-check
cve-sync-check:  ## Strict floor gate over every lock in the repo. Every violation counts.
	@$(CVE_SYNC) check --target $(CVE_SYNC_TARGET)

# A copier template ships pre-baked lock artifacts, and those are what
# reach a customer. `check` already covers them; this narrows to just them.
# Worth running even when `sync` is clean: a current residue does not prove
# the committed locks were regenerated.
.PHONY: cve-sync-check-templates
cve-sync-check-templates:  ## Floor gate over the lock artifacts a copier template ships.
	@$(CVE_SYNC) check --target $(CVE_SYNC_TARGET) --scope templates

# Safe to require, unlike `check`: a strict check reds every open pull
# request the moment a floor lands upstream.
#
# The CLI reads each baseline out of git itself. Never `git show
# <rev>:<path>` one by hand: a missing path can yield empty output, which
# parses as an empty lock and passes.
.PHONY: cve-sync-gate
cve-sync-gate:  ## What CI runs on a PR: fail only on violations this branch introduces relative to the base ref. A floor landing upstream never fails it.
	@$(CVE_SYNC) check --target $(CVE_SYNC_TARGET) --baseline-ref $(CVE_SYNC_BASE_REF)

# In a copier template repo the template is the product. Keep the strict
# check-templates on the scheduled job too: this asks whether the branch
# introduced a violation, strict asks whether the shipped locks comply.
.PHONY: cve-sync-gate-templates
cve-sync-gate-templates:  ## What CI runs on a PR for a copier template's shipped locks: fail only on violations this branch introduces.
	@$(CVE_SYNC) check --target $(CVE_SYNC_TARGET) --scope templates --baseline-ref $(CVE_SYNC_BASE_REF)

# CI rewrites this file on every resync, so a mismatch means the local
# checkout is behind. Pull, or run the resync.
.PHONY: cve-sync-wiring
cve-sync-wiring:  ## Is this repo's vendored cve-sync command file current with upstream?
	@$(CVE_SYNC) wiring --target $(CVE_SYNC_TARGET) --check

.PHONY: cve-sync-fix
cve-sync-fix:  ## (not here) Fixing a CVE writes policy, which only happens in a cve-sync clone.
	@printf '%s\n' \
	  'cve-sync: `fix` is not available in this repo.' \
	  '' \
	  'Fixing a CVE writes to cve-sync'\''s policy/, so it runs from a cve-sync' \
	  'checkout and edits both repos at once:' \
	  '' \
	  '    cd /path/to/cve-sync' \
	  '    task fix -- --target $(CVE_SYNC_TARGET)' \
	  '' \
	  'If you only need to pull already-merged policy into this repo, that is a' \
	  'different and much smaller thing, and it does belong here:' \
	  '' \
	  '    make cve-sync-sync      # splice the residue and re-lock' \
	  '    make cve-sync-status    # or just ask whether you are behind' \
	  '' \
	  >&2; \
	exit 1

.PHONY: cve-sync-fix-cve
cve-sync-fix-cve:  ## (not here) Same as fix, for a single CVE.
	@printf '%s\n' \
	  'cve-sync: `fix-cve` is not available in this repo.' \
	  '' \
	  'It writes cve-sync policy, so run it from a cve-sync checkout:' \
	  '' \
	  '    cd /path/to/cve-sync' \
	  '    task fix-cve -- --target $(CVE_SYNC_TARGET)' \
	  '' \
	  'To pull already-merged policy into this repo instead:' \
	  '' \
	  '    make cve-sync-sync' \
	  '' \
	  >&2; \
	exit 1
